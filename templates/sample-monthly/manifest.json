  "sequence": [
    {
      "section": "cover",
      "layout_id": "cover_v1"
    },
    {
      "section": "summary",
      "layout_id": "summary_v1"
    },
    {
      "section": "achievements",
      "layout_id": "achievements_v1"
    },
    {
      "section": "work_item_details",
      "layout_id": "achievement_detail_v1"
    },
    {
      "section": "challenges",
      "layout_id": "narrative_v1"
    },
    {
      "section": "improvements",
      "layout_id": "narrative_v1"
    },
    {
      "section": "next_plan",
      "layout_id": "narrative_v1"
    },
    {
      "section": "other_work",
      "layout_id": "narrative_v1"
    }
