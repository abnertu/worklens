        {
          "id": "items",
          "placeholder": {
            "idx": 13
          },
          "kind": "table",
          "max_items": 6,
          "max_chars": 40,
          "overflow": "split"
        }
      ]
    },
    {
      "id": "achievement_detail_v1",
      "slide_layout_name": "Title and Content",
      "purpose": "work_item_detail",
      "slots": [
        {
          "id": "title",
          "placeholder": {
            "idx": 0
          },
          "kind": "text",
          "required": true,
          "max_chars": 32
        },
        {
          "id": "facts",
          "placeholder": {
            "name": "Content Placeholder 2"
          },
          "kind": "bullets",
          "max_items": 5,
          "max_chars": 54,
          "overflow": "split"
        }
      ]
    },
    {
      "id": "narrative_v1",
      "slide_layout_name": "Title and Content",
      "purpose": "narrative",
      "slots": [
        {
          "id": "title",
          "placeholder": {
            "idx": 0
          },
          "kind": "text",
          "required": true,
          "max_chars": 32
        },
        {
          "id": "body",
          "placeholder": {
            "idx": 1
          },
          "kind": "bullets",
          "max_items": 5,
          "max_chars": 54,
          "overflow": "split"
        }
      ]
    }
