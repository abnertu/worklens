            "name": "Content Placeholder 3"
          },
          "kind": "table",
          "max_items": 5,
          "max_chars": 30,
          "overflow": "truncate"
        }
      ]
    },
    {
      "id": "achievements_v1",
      "slide_layout_name": "Title and Table",
