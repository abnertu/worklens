    "confidence_medium": "中",
    "confidence_high": "高",
    "cell_status_completed": "完成",
    "cell_status_in_progress": "進行中",
    "cell_status_unknown": "待確認",
    "status_in_progress": "(狀態: 進行中)",
    "status_unknown": "(狀態: 待確認)",
    "human_notes": "(人工補充) {notes}"
  }
