<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>WorkLens.Rendering.Pptx.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkLens.Rendering.Pptx\WorkLens.Rendering.Pptx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\templates\sample-monthly\*" Link="templates\sample-monthly\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Fixtures\**\*" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\schemas\presentation-ir\1.0\examples\valid\*.json" Link="examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Snapshots\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
