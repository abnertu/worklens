{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worklens:schema:presentation-ir:1.0",
  "title": "WorkLens Presentation IR 1.0",
  "description": "Deterministic slide structure: ordered slides with layout ids and slot bindings. No coordinates, fonts or colors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "presentation_id", "source_report", "template", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "presentation_id": { "type": "string", "pattern": "^prs-[a-z0-9-]+$" },
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "sha256"],
      "properties": {
        "report_id": { "type": "string", "pattern": "^rpt-[a-z0-9-]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layout_id", "bindings", "source_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^slide-[0-9]{3,}$" },
        "layout_id": { "$ref": "#/$defs/identifier" },
        "bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/slot_value" }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(wi|nr|ev)-[a-z0-9-]+$" }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "total"],
          "properties": {
            "index": { "type": "integer", "minimum": 1 },
            "total": { "type": "integer", "minimum": 2 }
          }
        }
      }
    },
    "slot_value": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "bullets", "table"] }
      },
      "oneOf": [
        { "$ref": "#/$defs/text_value" },
        { "$ref": "#/$defs/bullets_value" },
        { "$ref": "#/$defs/table_value" }
      ]
    },
    "text_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "text" },
        "text": { "type": "string" },
        "truncated": { "type": "boolean" }
      }
    },
    "bullets_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "bullets" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "level"],
            "properties": {
              "text": { "type": "string" },
              "level": { "type": "integer", "minimum": 0, "maximum": 2 }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "table_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "columns", "rows"],
      "properties": {
        "kind": { "const": "table" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
