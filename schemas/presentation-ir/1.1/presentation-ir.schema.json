{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worklens:schema:presentation-ir:1.1",
  "title": "WorkLens Presentation IR 1.1",
  "description": "Deterministic slide structure: ordered slides with layout ids and slot bindings. No coordinates, fonts or colors. Style roles name manifest styles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "presentation_id", "source_report", "template", "slides"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "presentation_id": { "type": "string", "pattern": "^prs-[a-z0-9-]+$" },
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "sha256"],
      "properties": {
        "report_id": { "type": "string", "pattern": "^rpt-[a-z0-9-]+$" },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the report.json file bytes as written.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    },
    "footer": {
      "description": "Footer text of every slide.",
      "type": "string"
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "style": {
      "description": "Style role: the id of a style in the Template Manifest.",
      "$ref": "#/$defs/identifier"
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layout_id", "bindings", "source_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^slide-[0-9]{3,}$" },
        "layout_id": { "$ref": "#/$defs/identifier" },
        "bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/slot_value" }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(wi|nr|ev)-[a-z0-9-]+$" }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "total"],
          "properties": {
            "index": { "type": "integer", "minimum": 1 },
            "total": { "type": "integer", "minimum": 2 }
          }
        }
      }
    },
    "slot_value": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "bullets", "table", "metric"] }
      },
      "oneOf": [
        { "$ref": "#/$defs/text_value" },
        { "$ref": "#/$defs/bullets_value" },
        { "$ref": "#/$defs/table_value" },
        { "$ref": "#/$defs/metric_value" }
      ]
    },
    "text_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "text" },
        "text": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "truncated": { "type": "boolean" }
      }
    },
    "bullets_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "bullets" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "level"],
            "properties": {
              "text": { "type": "string" },
              "level": { "type": "integer", "minimum": 0, "maximum": 2 },
              "style": { "$ref": "#/$defs/style" }
            }
          }
        },
        "style": { "$ref": "#/$defs/style" },
        "truncated": { "type": "boolean" }
      }
    },
    "table_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "columns", "rows"],
      "properties": {
        "kind": { "const": "table" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/cell" }
          }
        },
        "style": { "$ref": "#/$defs/style" },
        "truncated": { "type": "boolean" }
      }
    },
    "cell": {
      "description": "A table cell: its text, or its text with a style role.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "style"],
          "properties": {
            "text": { "type": "string" },
            "style": { "$ref": "#/$defs/style" }
          }
        }
      ]
    },
    "metric_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "value"],
      "properties": {
        "kind": { "const": "metric" },
        "label": { "type": "string" },
        "value": {
          "description": "Display text of the number, formatted by the Layout Resolver.",
          "type": "string"
        },
        "caption": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
