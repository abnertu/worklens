{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worklens:schema:evidence-ir:1.1",
  "title": "WorkLens Evidence IR 1.1",
  "description": "Source-agnostic, traceable evidence collected from work systems (GitHub, GitLab).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "generated_at",
    "generator",
    "query",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^evd-[a-z0-9-]+$"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "identities",
        "sources"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/period"
        },
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "platform": {
                "$ref": "#/$defs/platform"
              },
              "username": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "base_url",
              "repository"
            ],
            "properties": {
              "platform": {
                "$ref": "#/$defs/platform"
              },
              "base_url": {
                "type": "string",
                "format": "uri"
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "issue_status_labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[0-9a-f]{16}$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "title",
        "author",
        "timestamps",
        "fetched_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidence_id"
        },
        "kind": {
          "enum": [
            "commit",
            "change_request",
            "issue",
            "issue_activity"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "base_url",
            "repository",
            "external_id",
            "url"
          ],
          "properties": {
            "platform": {
              "$ref": "#/$defs/platform"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "external_id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "state": {
          "enum": [
            "open",
            "closed",
            "merged"
          ]
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "role": {
              "enum": [
                "author",
                "co_author",
                "committer",
                "actor",
                "assignee"
              ]
            }
          }
        },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "occurred_at"
          ],
          "properties": {
            "occurred_at": {
              "$ref": "#/$defs/timestamp"
            },
            "authored_at": {
              "$ref": "#/$defs/timestamp"
            },
            "committed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "created_at": {
              "$ref": "#/$defs/timestamp"
            },
            "merged_at": {
              "$ref": "#/$defs/timestamp"
            },
            "closed_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files_changed",
            "additions",
            "deletions"
          ],
          "properties": {
            "files_changed": {
              "type": "integer",
              "minimum": 0
            },
            "additions": {
              "type": "integer",
              "minimum": 0
            },
            "deletions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target_id"
            ],
            "properties": {
              "type": {
                "enum": [
                  "contains",
                  "references",
                  "closes"
                ]
              },
              "target_id": {
                "$ref": "#/$defs/evidence_id"
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "merge_commit",
              "revert",
              "bot",
              "duplicate"
            ]
          }
        },
        "fetched_at": {
          "$ref": "#/$defs/timestamp"
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue_transition"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "issue_activity"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "state",
              "transitions"
            ],
            "properties": {
              "state": {
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "author": {
                "required": [
                  "username"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "actor",
                      "assignee"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "issue_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "change",
        "actor"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "change": {
          "enum": [
            "status",
            "closed",
            "reopened"
          ]
        },
        "actor": {
          "enum": [
            "subject",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "change": {
            "const": "status"
          }
        },
        "required": [
          "change"
        ]
      },
      "then": {
        "required": [
          "label"
        ]
      }
    }
  }
}
