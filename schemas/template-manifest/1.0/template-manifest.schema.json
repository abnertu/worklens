{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worklens:schema:template-manifest:1.0",
  "title": "WorkLens Template Manifest 1.0",
  "description": "Declares the legal layouts and slots of a .pptx template and the order of report sections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template", "layouts", "sequence"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "file": {
          "description": "Path of the .pptx template, relative to the directory that contains this manifest file.",
          "type": "string",
          "pattern": "\\.pptx$"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the template file bytes as written.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "labels": { "$ref": "#/$defs/labels" },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layout" }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "layout_id"],
        "properties": {
          "section": {
            "enum": ["cover", "summary", "achievements", "work_item_details", "challenges", "improvements", "next_plan", "other_work", "closing"]
          },
          "layout_id": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "labels": {
      "description": "Fixed text used by the Layout Resolver. Placeholders in braces (for example {period}) are substituted once. Missing keys fall back to English defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cover_title": { "$ref": "#/$defs/label" },
        "summary_title": { "$ref": "#/$defs/label" },
        "summary_status": { "$ref": "#/$defs/label" },
        "summary_activity": { "$ref": "#/$defs/label" },
        "activity_columns": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/label" } },
        "achievements_title": { "$ref": "#/$defs/label" },
        "achievements_columns": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/label" } },
        "challenges_title": { "$ref": "#/$defs/label" },
        "improvements_title": { "$ref": "#/$defs/label" },
        "next_plan_title": { "$ref": "#/$defs/label" },
        "other_work_title": { "$ref": "#/$defs/label" },
        "closing_title": { "$ref": "#/$defs/label" },
        "inference": { "$ref": "#/$defs/label" },
        "confidence_low": { "$ref": "#/$defs/label" },
        "confidence_medium": { "$ref": "#/$defs/label" },
        "confidence_high": { "$ref": "#/$defs/label" },
        "cell_status_completed": { "$ref": "#/$defs/label" },
        "cell_status_in_progress": { "$ref": "#/$defs/label" },
        "cell_status_unknown": { "$ref": "#/$defs/label" },
        "status_in_progress": { "$ref": "#/$defs/label" },
        "status_unknown": { "$ref": "#/$defs/label" },
        "human_notes": { "$ref": "#/$defs/label" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slide_layout_name", "purpose", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "slide_layout_name": { "type": "string", "minLength": 1 },
        "purpose": { "enum": ["cover", "summary", "achievements", "work_item_detail", "narrative", "closing"] },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "placeholder", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "placeholder": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "idx": { "type": "integer", "minimum": 0 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "kind": { "enum": ["text", "bullets", "table"] },
        "required": { "type": "boolean" },
        "max_chars": { "type": "integer", "minimum": 1 },
        "max_items": { "type": "integer", "minimum": 1 },
        "overflow": { "enum": ["split", "truncate"] }
      }
    }
  }
}
