{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worklens:schema:template-manifest:1.1",
  "title": "WorkLens Template Manifest 1.1",
  "description": "Declares the legal layouts and slots of a .pptx template, the order of report sections and the style roles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template", "layouts", "sequence"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "file": {
          "description": "Path of the .pptx template, relative to the directory that contains this manifest file.",
          "type": "string",
          "pattern": "\\.pptx$"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the template file bytes as written.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "labels": { "$ref": "#/$defs/labels" },
    "styles": {
      "description": "Style roles by id. The renderer takes run and cell formats only from these roles.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/style" }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chars": { "type": "integer", "minimum": 1 }
      }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layout" }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "layout_id"],
        "properties": {
          "section": {
            "enum": ["cover", "summary", "achievements", "work_item_details", "operations", "operation_details", "challenges", "improvements", "next_plan", "support", "other_work", "closing"]
          },
          "layout_id": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "labels": {
      "description": "Fixed text used by the Layout Resolver. Placeholders in braces (for example {period}) are substituted once. Missing keys fall back to English defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cover_title": { "$ref": "#/$defs/label" },
        "summary_title": { "$ref": "#/$defs/label" },
        "summary_status": { "$ref": "#/$defs/label" },
        "summary_activity": { "$ref": "#/$defs/label" },
        "activity_columns": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/label" } },
        "achievements_title": { "$ref": "#/$defs/label" },
        "achievements_columns": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/label" } },
        "challenges_title": { "$ref": "#/$defs/label" },
        "improvements_title": { "$ref": "#/$defs/label" },
        "next_plan_title": { "$ref": "#/$defs/label" },
        "other_work_title": { "$ref": "#/$defs/label" },
        "closing_title": { "$ref": "#/$defs/label" },
        "inference": { "$ref": "#/$defs/label" },
        "confidence_low": { "$ref": "#/$defs/label" },
        "confidence_medium": { "$ref": "#/$defs/label" },
        "confidence_high": { "$ref": "#/$defs/label" },
        "cell_status_completed": { "$ref": "#/$defs/label" },
        "cell_status_in_progress": { "$ref": "#/$defs/label" },
        "cell_status_unknown": { "$ref": "#/$defs/label" },
        "status_in_progress": { "$ref": "#/$defs/label" },
        "status_unknown": { "$ref": "#/$defs/label" },
        "human_notes": { "$ref": "#/$defs/label" },
        "cover_kicker": { "$ref": "#/$defs/label" },
        "period_title": { "$ref": "#/$defs/label" },
        "cover_subtitle": { "$ref": "#/$defs/label" },
        "cover_sources": { "$ref": "#/$defs/label" },
        "metric_completed": { "$ref": "#/$defs/label" },
        "metric_completed_caption": { "$ref": "#/$defs/label" },
        "metric_in_progress": { "$ref": "#/$defs/label" },
        "metric_in_progress_caption": { "$ref": "#/$defs/label" },
        "metric_operations": { "$ref": "#/$defs/label" },
        "metric_operations_caption": { "$ref": "#/$defs/label" },
        "metric_projects": { "$ref": "#/$defs/label" },
        "metric_projects_caption": { "$ref": "#/$defs/label" },
        "highlights_title": { "$ref": "#/$defs/label" },
        "highlights_empty": { "$ref": "#/$defs/label" },
        "support_title": { "$ref": "#/$defs/label" },
        "support_more": { "$ref": "#/$defs/label" },
        "support_empty": { "$ref": "#/$defs/label" },
        "continuation": { "$ref": "#/$defs/label" },
        "facts_title": { "$ref": "#/$defs/label" },
        "evidence_title": { "$ref": "#/$defs/label" },
        "evidence_state_open": { "$ref": "#/$defs/label" },
        "evidence_state_closed": { "$ref": "#/$defs/label" },
        "evidence_state_merged": { "$ref": "#/$defs/label" },
        "evidence_date": { "$ref": "#/$defs/label" },
        "operations_title": { "$ref": "#/$defs/label" },
        "challenges_status": { "$ref": "#/$defs/label" },
        "challenge_resolved": { "$ref": "#/$defs/label" },
        "challenge_open": { "$ref": "#/$defs/label" },
        "column_title": { "$ref": "#/$defs/label" },
        "column_project": { "$ref": "#/$defs/label" },
        "column_status": { "$ref": "#/$defs/label" },
        "column_evidence": { "$ref": "#/$defs/label" },
        "column_problem": { "$ref": "#/$defs/label" },
        "column_resolution": { "$ref": "#/$defs/label" },
        "evidence_commits": { "$ref": "#/$defs/label" },
        "evidence_issue": { "$ref": "#/$defs/label" },
        "human_origin": { "$ref": "#/$defs/label" },
        "detail_kicker": { "$ref": "#/$defs/label" },
        "project_more": { "$ref": "#/$defs/label" },
        "footer": { "$ref": "#/$defs/label" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slide_layout_name", "purpose", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "slide_layout_name": { "type": "string", "minLength": 1 },
        "purpose": { "enum": ["cover", "summary", "achievements", "work_item_detail", "operations", "narrative", "challenge_table", "closing"] },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slot" }
        },
        "brand": {
          "description": "Placeholders of this layout that receive the brand elements given to render.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["placeholder"],
              "properties": {
                "placeholder": { "$ref": "#/$defs/placeholder" }
              }
            },
            "unit_name": {
              "type": "object",
              "additionalProperties": false,
              "required": ["placeholder"],
              "properties": {
                "placeholder": { "$ref": "#/$defs/placeholder" },
                "max_chars": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "placeholder", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "placeholder": { "$ref": "#/$defs/placeholder" },
        "kind": { "enum": ["text", "bullets", "table", "metric"] },
        "required": { "type": "boolean" },
        "max_chars": { "type": "integer", "minimum": 1 },
        "max_items": { "type": "integer", "minimum": 1 },
        "overflow": { "enum": ["split", "truncate"] },
        "columns": {
          "description": "Table columns in order. Each width is a percentage of the table width; the widths add up to 100.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "width"],
            "properties": {
              "key": { "$ref": "#/$defs/identifier" },
              "width": { "type": "integer", "minimum": 1, "maximum": 100 },
              "max_chars": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "header_style": { "description": "Style role of the header row cells.", "$ref": "#/$defs/identifier" },
        "row_styles": {
          "description": "Style roles of the body rows, applied in a cycle.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "table_style": {
          "description": "GUID of the table style that the table uses.",
          "type": "string",
          "pattern": "^\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}$"
        }
      },
      "dependentSchemas": {
        "columns": { "$ref": "#/$defs/table_slot" },
        "header_style": { "$ref": "#/$defs/table_slot" },
        "row_styles": { "$ref": "#/$defs/table_slot" },
        "table_style": { "$ref": "#/$defs/table_slot" }
      }
    },
    "table_slot": { "properties": { "kind": { "const": "table" } } },
    "placeholder": {
      "description": "Identifies a placeholder on the slide layout by index and/or shape name.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "idx": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_size": { "$ref": "#/$defs/points" },
        "bold": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "fill": { "$ref": "#/$defs/color" },
        "border_bottom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "width"],
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "$ref": "#/$defs/points" }
          }
        }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "points": { "description": "A size in points.", "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 }
  }
}
