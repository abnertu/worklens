{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worklens:schema:config:1.0",
  "title": "WorkLens Configuration 1.0",
  "description": "worklens.json: identities, sources and options. Must not contain secrets; tokens are read from the environment variables named by token_env.",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "identities", "sources"],
  "properties": {
    "config_version": { "const": "1.0" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "timezone": {
      "description": "IANA time zone name used for month boundaries, for example Asia/Taipei. Defaults to the system time zone.",
      "type": "string",
      "minLength": 1
    },
    "identities": {
      "description": "Identities treated as the report subject. An identity without platform applies to every platform.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "platform": { "$ref": "#/$defs/platform" },
          "username": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "base_url", "repository"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "platform": { "$ref": "#/$defs/platform" },
          "base_url": {
            "description": "REST API root over https, for example https://api.github.com or https://ghe.example/api/v3.",
            "type": "string",
            "format": "uri"
          },
          "repository": { "type": "string", "minLength": 1 },
          "token_env": {
            "description": "Name of the environment variable that holds the token for this source.",
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "exclude": {
      "description": "Evidence that the digest leaves out (M2). collect only flags items.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bots": { "type": "boolean" },
        "merge_commits": { "type": "boolean" },
        "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_diff": { "type": "boolean" },
        "max_body_chars": { "type": "integer", "minimum": 1 },
        "path_depth": { "type": "integer", "minimum": 1 },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["default"] },
            "patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["match", "replace"],
                "properties": {
                  "match": { "type": "string", "minLength": 1, "format": "regex" },
                  "replace": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_manifest": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "platform": { "enum": ["github", "gitlab"] }
  }
}
